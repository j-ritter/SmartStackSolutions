<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/feature3_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_blue1"
    tools:context=".createIncome">

    <!-- Vertical Guidelines -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="32dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="32dp" />

    <!-- Scrollable Content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnCancelIncome"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Title -->
            <TextView
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_new_income"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="22sp"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvQuickEntryHintIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/quick_entry_hint"
                android:textColor="#647383"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutTemplatesIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/templateToggleIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvUseTemplateIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/use_template"
                        android:textColor="@color/colorSecondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/templateArrowIncome"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/use_template"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/colorPrimary" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/templateScrollIncome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/templateChipsIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvScanReviewHintIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:text="@string/scan_review_disclaimer"
                android:textColor="#647383"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Title Section -->
            <TextView
                android:id="@+id/txtLabelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_optional"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:layout_marginTop="8dp" />

            <EditText
                android:id="@+id/edtTitleIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/write_your_title"
                android:maxLength="30"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:textColorHint="#8A96A3"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <!-- Amount Section -->
            <TextView
                android:id="@+id/txtAmountIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/edtAmountIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/amount"
                android:inputType="numberDecimal"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:textColorHint="#8A96A3"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMoreDetailsIncome"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:text="@string/show_details"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSourceIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/source_payer"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtSourceIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/source_payer_hint"
                android:maxLength="50"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/income_color"
                android:textColorHint="#8A96A3"
                android:textSize="15sp" />

            <!-- Date Section -->
            <TextView
                android:id="@+id/txtDateIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/income_date"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/edtDateIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/income_date"
                android:inputType="text"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:textColorHint="#8A96A3"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <!-- Category Section -->
            <TextView
                android:id="@+id/txtCategoryIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerCategoriesIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue" />

            <!-- Subcategory Section -->
            <TextView
                android:id="@+id/txtSubcategoryIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subcategory"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerSubcategoriesIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue" />

            <!-- Repeat Section -->
            <TextView
                android:id="@+id/txtRepeatIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/repeat"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <Spinner
                android:id="@+id/spinnerRepeatIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue" />

            <TextView
                android:id="@+id/tvRecurrenceNoteIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/recurrence_one_year_explanation"
                android:textColor="#647383"
                android:textSize="12sp" />

            <!-- Comment Section -->
            <TextView
                android:id="@+id/txtCommentIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comments"
                android:textStyle="bold"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/edtCommentIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/write_your_comments"
                android:maxLength="50"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:textColorHint="#8A96A3"
                android:textColor="@color/textPrimary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/layoutAttachmentIncome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/attachment"
                    android:textColor="@color/colorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnUploadImageIncome"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/create_upload_button"
                    android:text="@string/upload"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/txtImageAddedIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/image_added"
                    android:textColor="@color/colorSecondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/checkSaveTemplateIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/save_as_template"
                android:textColor="@color/colorSecondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtTemplateNameIncome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_frame_background_blue"
                android:hint="@string/template_name_hint"
                android:maxLength="30"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/textPrimary"
                android:textColorHint="#8A96A3"
                android:textSize="15sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </ScrollView>

    <!-- Save and Cancel Buttons -->
    <Button
        android:id="@+id/btnCancelIncome"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btnlog"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/colorSecondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSaveIncome"
        app:layout_constraintStart_toStartOf="@+id/guidelineStart" />

    <Button
        android:id="@+id/btnSaveIncome"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btnlogin"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnCancelIncome"
        app:layout_constraintEnd_toEndOf="@+id/guidelineEnd" />

</androidx.constraintlayout.widget.ConstraintLayout>
