<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="6dp"
    app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/labelTitleItemsSpendings"
            android:layout_width="120dp"
            android:layout_height="18dp"
            android:text="@string/title"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textviewTitleItemsSpendings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/paidStatusGroupItemsSpendings"
            app:layout_constraintStart_toEndOf="@id/labelTitleItemsSpendings"
            app:layout_constraintTop_toTopOf="@id/labelTitleItemsSpendings"
            tools:text="Electricity bill" />

        <LinearLayout
            android:id="@+id/paidStatusGroupItemsSpendings"
            android:layout_width="58dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <CheckBox
                android:id="@+id/imgCheckBoxItemsSpendings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/checkbox_color_selector"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp" />

            <TextView
                android:id="@+id/imgCheckBoxItemsSpendingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/paid"
                android:textColor="@color/colorSecondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/labelCategoryItemsSpendings"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/category"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelTitleItemsSpendings" />

        <TextView
            android:id="@+id/textviewCategoryItemsSpendings"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/imgRecurringIconSpendings"
            app:layout_constraintStart_toEndOf="@id/labelCategoryItemsSpendings"
            app:layout_constraintTop_toTopOf="@id/labelCategoryItemsSpendings"
            tools:text="Utilities" />

        <ImageView
            android:id="@+id/imgRecurringIconSpendings"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/recurring"
            android:src="@drawable/ic_recurring1"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/textviewCategoryItemsSpendings"
            app:layout_constraintEnd_toStartOf="@id/paidStatusGroupItemsSpendings"
            app:layout_constraintTop_toTopOf="@id/textviewCategoryItemsSpendings"
            app:tint="@color/colorSecondary" />

        <TextView
            android:id="@+id/labelAmountItemsSpendings"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/amount"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelCategoryItemsSpendings" />

        <TextView
            android:id="@+id/textviewAmountItemsSpendings"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:textColor="@color/spending_color"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/paidStatusGroupItemsSpendings"
            app:layout_constraintStart_toEndOf="@id/labelAmountItemsSpendings"
            app:layout_constraintTop_toTopOf="@id/labelAmountItemsSpendings"
            tools:text="$120.00" />

        <TextView
            android:id="@+id/labelDateItemsSpendings"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/purchase_date"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelAmountItemsSpendings" />

        <TextView
            android:id="@+id/textviewDateItemsSpendings"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginStart="12dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/paidStatusGroupItemsSpendings"
            app:layout_constraintStart_toEndOf="@id/labelDateItemsSpendings"
            app:layout_constraintTop_toTopOf="@id/labelDateItemsSpendings"
            tools:text="12/06/2026" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
