<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgEditBill"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/edit_open_payment"
                    android:padding="10dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/colorSecondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/bill_details"
                    android:textColor="@color/colorSecondary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/imgDeleteBill"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/delete_open_payment"
                    android:padding="10dp"
                    android:src="@drawable/ic_delete"
                    app:tint="@color/colorSecondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/title"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtTitleDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/colorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/amount"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtAmountDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:inputType="numberDecimal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/bill_color"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                style="@style/DetailDialogLabel"
                android:layout_marginTop="12dp"
                android:text="@string/due_date" />

            <EditText
                android:id="@+id/edtDateDialog"
                style="@style/DetailDialogInput" />

            <TextView
                style="@style/DetailDialogLabel"
                android:layout_marginTop="12dp"
                android:text="@string/repeat" />

            <EditText
                android:id="@+id/edtRepeatDialog"
                style="@style/DetailDialogInput" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/categorydbx"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtCategoryDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/colorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/subcategory"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtSubcategoryDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/colorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/vendor"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtVendorDialog"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/colorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/comments"
                android:textColor="#647383"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/edtCommentDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/auth_input_background"
                android:enabled="false"
                android:minHeight="72dp"
                android:gravity="top|start"
                android:padding="14dp"
                android:textColor="@color/colorSecondary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/attachment"
                android:textColor="#647383"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/edtAttachmentDialog"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:contentDescription="@string/open_payment_attachment"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCloseDialog"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/auth_google_button"
                    android:backgroundTint="@null"
                    android:minWidth="104dp"
                    android:text="@string/close"
                    android:textAllCaps="false"
                    android:textColor="@color/colorSecondary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSaveChanges"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/auth_primary_button"
                    android:backgroundTint="@null"
                    android:minWidth="104dp"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
