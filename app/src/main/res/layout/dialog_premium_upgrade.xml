<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_premium_upgrade_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="Premium"
        android:src="@drawable/ic_nav_premium" />

    <TextView
        android:id="@+id/tvPremiumUpgradeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/unlock_premium_features"
        android:textColor="@color/colorSecondary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPremiumUpgradeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#526273"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPremiumUpgrade"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/btnlogin"
        android:text="@string/unlock_button_text"
        android:textAllCaps="false"
        android:textColor="@color/colorOnPrimary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnPremiumUpgradeCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/create_upload_button"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp" />
</LinearLayout>
