<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="24dp"
    android:paddingEnd="28dp"
    android:paddingBottom="24dp"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="160dp"
        android:layout_height="132dp">

        <ImageView
            android:id="@+id/emptyStateImage"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/emptyStateHelp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="top|end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/show_tutorial_again"
            android:padding="8dp"
            android:src="@drawable/ic_info" />
    </FrameLayout>

    <TextView
        android:id="@+id/emptyStateTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/ssboldbody"
        android:gravity="center"
        android:textColor="@color/colorSecondary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/emptyStateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="#647383"
        android:textSize="14sp" />

    <Button
        android:id="@+id/emptyStateAction"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/tutorial_primary_button"
        android:backgroundTint="@null"
        android:minWidth="168dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textAllCaps="false"
        android:textColor="@color/white" />
</LinearLayout>
