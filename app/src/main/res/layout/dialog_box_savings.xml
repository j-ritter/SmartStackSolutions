<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feature6_constraint_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSavingsDialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/set_savings_target"
                    android:textColor="@color/colorSecondary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/savingsDialogActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnEditTargetSavingsAction"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/edit_target"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageButton
                            android:id="@+id/imgEditTargetSavings"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="false"
                            android:contentDescription="@string/edit_target"
                            android:focusable="false"
                            android:padding="8dp"
                            android:src="@drawable/ic_edit"
                            app:tint="@color/colorSecondary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/edit_target"
                            android:textColor="@color/colorSecondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="#DDE7EF" />

                    <LinearLayout
                        android:id="@+id/btnDeleteTargetSavingsAction"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:contentDescription="@string/delete_target"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageButton
                            android:id="@+id/imgDeleteTargetSavings"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="false"
                            android:contentDescription="@string/delete_target"
                            android:focusable="false"
                            android:padding="8dp"
                            android:src="@drawable/ic_delete"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/delete_target"
                            android:textColor="@color/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/savings_target_icon_bg">

                <ImageView
                    android:id="@+id/imgSavingsGoal"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/savings_goal_image"
                    android:scaleType="centerCrop"
                    android:src="@drawable/piggybank_1" />
            </FrameLayout>

            <TextView
                style="@style/SavingsDialogLabel"
                android:layout_marginTop="18dp"
                android:text="@string/name_target" />

            <Spinner
                android:id="@+id/spinnerTargetName"
                style="@style/SavingsDialogInput"
                android:layout_marginTop="6dp" />

            <TextView
                style="@style/SavingsDialogLabel"
                android:layout_marginTop="14dp"
                android:text="@string/target_amount" />

            <EditText
                android:id="@+id/edtTargetAmount"
                style="@style/SavingsDialogInput"
                android:layout_marginTop="6dp"
                android:inputType="numberDecimal"
                android:textColor="@color/colorSecondary" />

            <TextView
                style="@style/SavingsDialogLabel"
                android:layout_marginTop="14dp"
                android:text="@string/start_date" />

            <EditText
                android:id="@+id/edtStartDateSavings"
                style="@style/SavingsDialogInput"
                android:layout_marginTop="6dp"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/colorSecondary" />

            <TextView
                style="@style/SavingsDialogLabel"
                android:layout_marginTop="14dp"
                android:text="@string/end_date" />

            <EditText
                android:id="@+id/edtEndDateSavings"
                style="@style/SavingsDialogInput"
                android:layout_marginTop="6dp"
                android:focusable="false"
                android:inputType="none"
                android:textColor="@color/colorSecondary" />

            <TextView
                style="@style/SavingsDialogLabel"
                android:layout_marginTop="14dp"
                android:text="@string/monthly_savings" />

            <EditText
                android:id="@+id/edtMonthlySavings"
                style="@style/SavingsDialogInput"
                android:layout_marginTop="6dp"
                android:enabled="false"
                android:textColor="@color/colorSecondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCloseDialogSavings"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/create_upload_button"
                    android:text="@string/close"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSaveTargetSavings"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btnlogin"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.cardview.widget.CardView>
