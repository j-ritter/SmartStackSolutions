<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/infoPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/infoToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        android:elevation="2dp"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/colorSecondary"
        app:titleCentered="true"
        app:titleTextColor="@color/colorSecondary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="20dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <ImageView
                android:id="@+id/infoIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/savings_target_icon_bg"
                android:importantForAccessibility="no"
                android:padding="11dp"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/infoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="#647383"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/infoTextContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/main_menu_card"
                android:lineSpacingExtra="3dp"
                android:padding="18dp"
                android:textColor="@color/colorSecondary"
                android:textIsSelectable="true"
                android:textSize="15sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/infoSearchInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/main_menu_card"
                android:hint="@string/search_faqs"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/colorSecondary"
                android:textColorHint="#7A8794"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/infoAccordionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/infoPageImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/about_us_image_description"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
