<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_premium_upgrade_bg"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:layout_width="132dp"
        android:layout_height="132dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/savings_target_icon_bg"
        android:contentDescription="@string/savings_goal_image"
        android:padding="34dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_goal_general"
        android:tint="@color/colorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/target_achieved"
        android:textColor="@color/colorSecondary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/savings_target_reached_message"
        android:textColor="#526273"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCloseSavingsComplete"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/btnlogin"
        android:text="@string/close"
        android:textAllCaps="false"
        android:textColor="@color/colorOnPrimary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
