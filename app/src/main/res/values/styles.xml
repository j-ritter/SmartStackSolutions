<resources>
    <!-- Custom style for Spinner items -->
    <style name="SpinnerTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="BottomNavTextStyle" parent="TextAppearance.AppCompat">
        <item name="android:textSize">9sp</item>
    </style>
    <style name="PremiumFeatureCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">@drawable/main_menu_card</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:minHeight">76dp</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="PremiumDisclosureIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:padding">11dp</item>
        <item name="android:src">@drawable/ic_disclosure_down</item>
        <item name="android:tint">@color/colorPrimary</item>
    </style>
    <style name="SupportActionCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
    </style>
    <style name="SupportActionContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">82dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="SupportActionIcon">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/savings_target_icon_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/colorPrimary</item>
    </style>
    <style name="SupportActionTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SupportActionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SupportActionDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">#647383</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="SupportActionArrow">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:rotation">-90</item>
        <item name="android:src">@drawable/ic_disclosure_down</item>
        <item name="android:tint">@color/colorPrimary</item>
    </style>
    <style name="InsightTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="InsightDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">#647383</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="InsightPeriodButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="InsightPanel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/insight_panel_background</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>
    <style name="PremiumFeatureIcon">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>
    <style name="PremiumFeatureBadge">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
        <item name="android:src">@drawable/ic_star_orange</item>
        <item name="android:visibility">visible</item>
    </style>
    <style name="PremiumFeatureTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="PremiumFeatureTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PremiumFeatureDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">#647383</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="PremiumComparisonRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">11dp</item>
    </style>
    <style name="PremiumComparisonFeature">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.25</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PremiumComparisonFree">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">#647383</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="PremiumComparisonPremium">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SavingsDialogLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SavingsDialogInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/main_menu_card</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="DetailDialogLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#647383</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="DetailDialogInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/auth_input_background</item>
        <item name="android:enabled">false</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DetailDialogSecondaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/auth_google_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorSecondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DetailDialogPrimaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/auth_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
